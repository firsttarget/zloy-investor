# Скопируйте в .env и заполните. Файл .env НЕ коммитится (он в .gitignore).

# Персонаж инвестора: angel | corporate | grant | vc
INVESTOR=angel

# Провайдер: anthropic | openai | mock. Если пусто — выберется по наличию ключа, без ключа — mock (демо-режим).
LLM_PROVIDER=

# Claude (Anthropic API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Любой OpenAI-совместимый API (OpenAI, OpenRouter и т.п.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Таймаут одного запроса к модели, мс
LLM_TIMEOUT_MS=45000

PORT=3000
